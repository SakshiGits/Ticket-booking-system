# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Postgres) ---
# Port 5433 (not 5432) — docker-compose maps to 5433 by default to avoid clashing with
# a native Postgres install some machines already have listening on 5432.
DATABASE_URL=postgresql://ticketapp:ticketapp@localhost:5433/ticketbooking

# --- Redis (holds TTL scheduling, waitlist offer TTL, realtime pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Seat hold / waitlist offer timing (minutes) ---
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
# Fallback sweep for expired holds/offers missed by the scheduler (seconds)
EXPIRY_SWEEP_INTERVAL_SECONDS=30

# --- Email (any SMTP-compatible free tier, e.g. Resend, Brevo, Mailtrap) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace_with_smtp_api_key
EMAIL_FROM="Ticket Booking <no-reply@yourapp.com>"
